/*
 * mid7021_mq.dts — Onn 100135924 (mid7021_mq), MediaTek MT6765
 *
 * ARM64 board overlay scaffold for the v7a->v8a migration.
 * Modeled on the proven p410ae.dts overlay pattern in this tree, but stripped
 * to ONLY what the live device DTS (kernel_work/mid7021_analysis/mid7021_live.dts)
 * actually confirms. Do NOT add p410ae phone peripherals back without evidence.
 *
 * STATUS: UNVALIDATED SCAFFOLD. This is finalized through the build loop in
 * tools/build_arm64_kernel.sh — let compiler/dtc errors drive the include
 * wiring and node corrections. See MID7021_ARM64_DTS_PLAN_2026-05-31.md.
 *
 * Confirmed from live DTS:
 *   - SoC: mediatek,MT6765, 8x Cortex-A53
 *   - PMIC/charger/gauge: mt6357 (PMIC-integrated) — NO external mt6370/typec
 *   - Touch: goodix,touch on spi3
 *   - Connectivity: mt6765-consys (built-in wifi/bt)
 *   - androidboot.hardware=mt6765
 * Intentionally OMITTED (Motorola-only, absent on this tablet):
 *   - mt6370 PMU / mt6370_typec / mt6370_chg
 *   - fingerprint: spi0 fingerprint@0 / goodix_fp / fpsensor / fp_egistec
 *   - NFC (sec-nfc), AW9610x SAR, AW87xxx smart-PA, aw36514 flash
 */

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/mt6765-pinfunc.h>
#include <dt-bindings/clock/mt6765-clk.h>

/dts-v1/;
/plugin/;

/* chosen ----------------------------------------------------------------- *
 * On a real boot, LK detects the panel and passes videolfb-lcmname at
 * runtime. These are FPGA/no-LK fallbacks only.
 * TODO(panel): set lcmname to the mid7021 LCM driver name once the panel
 * driver is sourced. Candidates from defconfig CONFIG_CUSTOM_KERNEL_LCM:
 *   SAT070HK30I21Y03  MJT070032M  F070A67_601  RS070WS105A4
 * Panel geometry per defconfig: 600x1024, physical rotation 270 (=> 1024x600
 * landscape).
 */
&chosen {
	atag,videolfb-islcmfound = <1>;
	atag,videolfb-islcm_inited = <0>;
	atag,videolfb-lcmname = "MJT070032M";
};

/* Stock DTBO and expdb prove MJT070032M, reset GPIO45, power GPIO172, and
 * MT6357 VIBR LDO at 1.8 V; the existing MediaTek LCD LED keeps PWM control. */
&odm {
	panel1@1 {
		compatible = "MJT070032M";
		gpio_lcd_rst = <&pio 45 0>;
		gpio_lcd_pwr = <&pio 172 0>;
		max-brightness = <230>;
		lcm_vddio-supply = <&mt_pmic_vibr_ldo_reg>;
		status = "okay";
	};
};

&mt_pmic_vibr_ldo_reg {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
	regulator-active-discharge = <1>;
};

/* Audio ------------------------------------------------------------------ *
 * TODO(audio): confirm speaker amp from live DTS. p410ae used AWINIC AW87xxx
 * on i2c3 + I2S3 routing — likely different (or internal class-D via mt6357)
 * on this tablet. Leave amp out until confirmed; mt6357 codec comes from base.
 */

/* Audio speaker amp - CONFIRMED 2026-06-23 from v7a live DT (root su):
 * i2c3@1100f000/speaker_amp@34, compatible mediatek,speaker_amp, reg 0x34,
 * driver-bound on stock v7a via mtk-soc-speaker-amp.c (Speaker_Amp_Switch kctl).
 * aw87519@58 on i2c6 is declared but UNDRIVEN on v7a -> donor red herring.
 */
&i2c3 {
	speaker_amp@34 {
		compatible = "mediatek,speaker_amp";
		reg = <0x34>;
		status = "okay";
	};
};

/* Board peripheral dtsis (these ARE correct for mid7021) ----------------- */
#include "mediatek/cust_mt6765_camera_mid7021.dtsi"
#include "mediatek/cust_mt6765_touch_mid7021.dtsi"
/* End of file, DO NOT ADD ANYTHING HERE */
